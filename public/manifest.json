{
  "manifest_version": 3,
  "name": "FlowTour - Interactive Demo & Workflow Recorder",
  "version": "1.0.1",
  "description": "Capture web app workflows, record clicks & screenshots, and export self-hosted interactive walkthrough widgets.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://flowtour.dev/*",
      "https://*.flowtour.dev/*",
      "https://flowtour.vercel.app/*",
      "https://*.vercel.app/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "action": {
    "default_title": "Open FlowTour"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scripts/recorder.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
