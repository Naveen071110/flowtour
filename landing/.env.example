# ==============================================================================
# FlowTour Landing Page & Licensing API Environment Variables
# ==============================================================================

# Dodo Payments Mode ('test' or 'live')
DODO_PAYMENTS_MODE=test

# Webhook secret from Dodo Payments Dashboard (Webhooks section)
DODO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Secret key used for cryptographic HMAC-SHA256 signing of proTokens & license keys
LICENSE_SECRET_KEY=your_secure_random_license_signing_secret_here

# Optional: Dodo Payments REST API key for server-side payment lookups
# DODO_PAYMENTS_API_KEY=your_dodo_api_key_here

# Chrome Web Store Published Extension ID
NEXT_PUBLIC_FLOWTOUR_EXTENSION_ID=emaghcilmigcakcnnfonmgbfcddhikki

# Dodo Payments Checkout Redirect URL
NEXT_PUBLIC_DODO_PAYMENT_URL=https://test.checkout.dodopayments.com/buy/pdt_0NnO9Yu0LqYXonkP2yh8E?quantity=1&redirect_url=https%3A%2F%2Fflowtour.vercel.app%2Fsuccess

# Optional: PostHog Analytics
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
